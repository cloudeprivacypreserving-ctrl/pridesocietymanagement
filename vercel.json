{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api/residents/:id", "destination": "/api/residents" },
    { "source": "/api/users/:id", "destination": "/api/users" },
    { "source": "/api/issues/:id", "destination": "/api/issues" },
    { "source": "/api/pending/:id/:action", "destination": "/api/pending" },
    { "source": "/api/vehicles/:id", "destination": "/api/vehicles" },
    { "source": "/api/photos/:action", "destination": "/api/photos" },
    { "source": "/api/profile/:action", "destination": "/api/profile" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
